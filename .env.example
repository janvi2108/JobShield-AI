# ==============================================================================
# JobShield AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your values for local overrides.
# The application runs fully offline without any external API key.
# External AI (Groq) integration is OPTIONAL and disabled by default.
# NEVER commit .env or any real API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Runtime Settings
# ------------------------------------------------------------------------------
APP_NAME=JobShield AI
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8008
API_V1_PREFIX=/api

# CORS Allowed Origins (comma-separated; include your Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Frontend Settings (Vite — prefix all frontend env vars with VITE_)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8008/api

# ------------------------------------------------------------------------------
# Machine Learning
# ------------------------------------------------------------------------------
# The Linear SVM champion model is loaded from models/model.joblib automatically.
# No configuration required. Do not change or retrain unless intentional.
# MODEL_PATH=models/model.joblib
# METRICS_PATH=models/metrics.json

# ------------------------------------------------------------------------------
# Database (SQLite — no server required)
# ------------------------------------------------------------------------------
# SQLite database path relative to the project root.
# Leave blank to use the default: jobshield.db in the project root.
# DATABASE_URL=sqlite:///./jobshield.db

# ------------------------------------------------------------------------------
# LLM & Grounded Explainability (OPTIONAL — disabled by default)
# ------------------------------------------------------------------------------
# LLM_PROVIDER=none means the application uses the local deterministic explanation
# engine. No API key is required and no external requests are made.
#
# To enable optional Groq AI-enhanced explanations:
#   1. Set LLM_PROVIDER=groq
#   2. Set LLM_API_KEY to your actual Groq API key
#   3. Restart the backend
#
# The deterministic explanation engine always remains as a guaranteed fallback.
LLM_PROVIDER=none
# LLM_API_KEY=your_groq_api_key_here
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_TIMEOUT=30
# LLM_TEMPERATURE=0.1

# ------------------------------------------------------------------------------
# URL Extraction & SSRF Protection
# ------------------------------------------------------------------------------
URL_FETCH_TIMEOUT=10
MAX_URL_CONTENT_BYTES=2097152
