# JobShield AI Environment Configuration Template
# Copy this file to .env for local overrides if needed

# Backend Settings
APP_NAME=JobShield AI
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
API_V1_PREFIX=/api

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Settings (Vite prefix VITE_)
VITE_API_BASE_URL=http://127.0.0.1:8000/api
